[Unit]
Description=Toggle microphone once per Fn+F7 press (reads evdev directly)
Documentation=file:/usr/local/lib/honor-fmbp/mic-mute-key.sh
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=/usr/local/lib/honor-fmbp/mic-mute-key.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
